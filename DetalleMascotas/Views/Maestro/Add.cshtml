@model DetalleMascotas.Models.ViewModel.OwnerViewModel

@{
    ViewBag.Title = "Detalle Mascotas";
    var mascotas = Model?.Mascotas ?? new List<DetalleMascotas.Models.ViewModel.MascotaViewModel>();
}

<h2>@ViewBag.Title</h2>

<span>@ViewBag.Message</span>

@using (Html.BeginForm("Add", "Maestro", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="row">
        <div class="form-group">
            @Html.LabelFor(o => o.OwnerName)
            @Html.TextBoxFor(o => o.OwnerName)
            @Html.ValidationMessageFor(o => o.OwnerName)
        </div>
        <div class="form-group">
            @Html.LabelFor(o => o.OwnerAddress)
            @Html.TextBoxFor(o => o.OwnerAddress)
        </div>
        <div class="form-group">
            @Html.LabelFor(o => o.OwnerPhone)
            @Html.TextBoxFor(o => o.OwnerPhone)
        </div>
    </div>
    <br />
    <h3>Mascotas</h3>
    <hr />
    <div class="row">
        <div class="form-group">
            <label>Pet Name</label>
            <input type="text" id="PetName" alt="Pet Name" />
            <label>Age</label>
            <input type="number" id="Age" alt="Age" min="0" />
            <label>Color</label>
            <input type="text" id="Color" alt="Color" />
            <input type="button" value="Add" id="Add" onclick="AddPet(); return false;" />
        </div>
        <div id="MascotasDiv">
            <table id="MascotasTable">
                <tr>
                    <th>Pet Name</th>
                    <th>Age</th>
                    <th>Color</th>
                    <th></th>
                </tr>
            </table>
        </div>
        <br />
        <div class="form-group">
            <input type="submit" value="Submit" class="btn btn-primary" />
        </div>
    </div>
}

<script>
    var num = 0;

    function AddPet() {
        var petName = document.getElementById("PetName").value.trim();
        var age = document.getElementById("Age").value;
        var color = document.getElementById("Color").value.trim();

        if (petName === "") {
            alert("Pet Name is required");
            return;
        }

        AddPetRow(petName, age, color);

        //clear values
        document.getElementById("PetName").value = "";
        document.getElementById("Age").value = "";
        document.getElementById("Color").value = "";
    }

    function AddPetRow(petName, age, color) {
        var index = num++;
        var table = document.getElementById("MascotasTable");
        var row = table.insertRow(1);
        row.insertCell(0).textContent = petName;
        row.insertCell(1).textContent = age;
        row.insertCell(2).textContent = color;

        //hidden fields live inside the row so removing the row removes the pet
        var hiddenCell = row.insertCell(3);
        hiddenCell.appendChild(HiddenField("Mascotas.Index", index));
        hiddenCell.appendChild(HiddenField("Mascotas[" + index + "].PetName", petName));
        hiddenCell.appendChild(HiddenField("Mascotas[" + index + "].age", age));
        hiddenCell.appendChild(HiddenField("Mascotas[" + index + "].color", color));

        var removeButton = document.createElement("input");
        removeButton.type = "button";
        removeButton.value = "Remove";
        removeButton.onclick = function () { row.remove(); };
        hiddenCell.appendChild(removeButton);
    }

    function HiddenField(name, value) {
        var field = document.createElement("input");
        field.type = "hidden";
        field.name = name;
        field.value = value;
        return field;
    }

    //restore pets when the form is redisplayed after an error
    @foreach (var m in mascotas)
    {
        @:AddPetRow(@Html.Raw(HttpUtility.JavaScriptStringEncode(m.PetName ?? "", true)), @Html.Raw(HttpUtility.JavaScriptStringEncode(m.age?.ToString() ?? "", true)), @Html.Raw(HttpUtility.JavaScriptStringEncode(m.color ?? "", true)));
    }
</script>
